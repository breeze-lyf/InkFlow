{
  "name": "inkflow",
  "productName": "墨流 InkFlow",
  "version": "1.0.0",
  "description": "优雅流畅的桌面 Markdown 编辑器 —— 即时渲染 · 文件库 · 命令面板",
  "main": "main/main.js",
  "author": "InkFlow",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "cross-env SMOKE=1 electron . || SMOKE=1 electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "vditor": "^3.10.8"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inkflow.markdown",
    "productName": "墨流",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "samples/**/*",
      "assets/icon.png",
      "node_modules/vditor/dist/**/*",
      "node_modules/@oozcitak/dom/**",
      "node_modules/@oozcitak/infra/**",
      "node_modules/@oozcitak/infra/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/url/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/infra/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/infra/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/util/**",
      "node_modules/browser-split/**",
      "node_modules/call-bind-apply-helpers/**",
      "node_modules/call-bound/**",
      "node_modules/camelize/**",
      "node_modules/color-name/**",
      "node_modules/core-util-is/**",
      "node_modules/diff-match-patch/**",
      "node_modules/dom-serializer/**",
      "node_modules/dom-serializer/node_modules/domelementtype/**",
      "node_modules/dom-serializer/node_modules/entities/**",
      "node_modules/dom-walk/**",
      "node_modules/domelementtype/**",
      "node_modules/domhandler/**",
      "node_modules/domutils/**",
      "node_modules/dunder-proto/**",
      "node_modules/encoding/**",
      "node_modules/ent/**",
      "node_modules/ent/node_modules/punycode/**",
      "node_modules/entities/**",
      "node_modules/error/**",
      "node_modules/es-define-property/**",
      "node_modules/es-errors/**",
      "node_modules/es-object-atoms/**",
      "node_modules/ev-store/**",
      "node_modules/function-bind/**",
      "node_modules/get-intrinsic/**",
      "node_modules/get-proto/**",
      "node_modules/global/**",
      "node_modules/gopd/**",
      "node_modules/has-symbols/**",
      "node_modules/has-tostringtag/**",
      "node_modules/hasown/**",
      "node_modules/html-entities/**",
      "node_modules/html-to-docx/**",
      "node_modules/html-to-vdom/**",
      "node_modules/htmlparser2/**",
      "node_modules/iconv-lite/**",
      "node_modules/image-size/**",
      "node_modules/image-to-base64/**",
      "node_modules/immediate/**",
      "node_modules/individual/**",
      "node_modules/inherits/**",
      "node_modules/is-object/**",
      "node_modules/is-regex/**",
      "node_modules/isarray/**",
      "node_modules/jszip/**",
      "node_modules/jszip/node_modules/readable-stream/**",
      "node_modules/jszip/node_modules/safe-buffer/**",
      "node_modules/jszip/node_modules/string_decoder/**",
      "node_modules/lie/**",
      "node_modules/lodash/**",
      "node_modules/math-intrinsics/**",
      "node_modules/mime-db/**",
      "node_modules/mime-types/**",
      "node_modules/min-document/**",
      "node_modules/nanoid/**",
      "node_modules/next-tick/**",
      "node_modules/node-fetch/**",
      "node_modules/pako/**",
      "node_modules/process/**",
      "node_modules/process-nextick-args/**",
      "node_modules/queue/**",
      "node_modules/readable-stream/**",
      "node_modules/safe-buffer/**",
      "node_modules/safe-regex-test/**",
      "node_modules/safer-buffer/**",
      "node_modules/setimmediate/**",
      "node_modules/string_decoder/**",
      "node_modules/string-template/**",
      "node_modules/tr46/**",
      "node_modules/util-deprecate/**",
      "node_modules/vditor/**",
      "node_modules/virtual-dom/**",
      "node_modules/webidl-conversions/**",
      "node_modules/whatwg-url/**",
      "node_modules/x-is-array/**",
      "node_modules/x-is-string/**",
      "node_modules/xmlbuilder2/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/dom/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/dom/node_modules/@oozcitak/util/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/util/**",
      "node_modules/xtend/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "墨流 InkFlow",
      "window": {
        "width": 560,
        "height": 360
      }
    },
    "asarUnpack": [
      "node_modules/html-to-docx/**"
    ]
  }
}