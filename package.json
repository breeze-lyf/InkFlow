{
  "name": "inkflow",
  "productName": "墨流 InkFlow",
  "version": "1.0.5",
  "description": "优雅流畅的桌面 Markdown 编辑器 —— 即时渲染 · 文件库 · 命令面板",
  "main": "main/main.js",
  "author": "InkFlow",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vditor.js",
    "start": "electron .",
    "smoke": "node scripts/run-smoke.js --source --expect 44",
    "test": "node scripts/run-npm-tasks.js test:unit test:syntax",
    "test:unit": "node scripts/run-unit-tests.js",
    "test:syntax": "node scripts/check-syntax.js",
    "test:smoke": "node scripts/run-smoke.js --source --expect 44",
    "test:packaged": "node scripts/run-smoke.js --packaged --expect 44",
    "version:check": "node scripts/check-versions.js",
    "artifacts:check": "node scripts/check-artifacts.js --platform mac",
    "verify": "node scripts/run-npm-tasks.js test version:check test:smoke",
    "release:sync": "node scripts/release.js sync",
    "release:check": "node scripts/release.js check",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac --dir",
    "pack:win": "electron-builder --win --dir",
    "pack:linux": "electron-builder --linux --dir",
    "dist": "electron-builder --mac dmg zip && bash scripts/dmg-post.sh",
    "dist:win": "electron-builder --win nsis zip",
    "dist:linux": "electron-builder --linux AppImage zip",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {
    "html-to-docx": "1.8.0",
    "htmlparser2": "12.0.0",
    "vditor": "3.11.3"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "build": {
    "appId": "com.inkflow.markdown",
    "productName": "墨流",
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "THIRD-PARTY-LICENSES.md",
      "main/**/*",
      "renderer/**/*",
      "samples/**/*",
      "assets/icon.png",
      "assets/brand-lockup.png",
      "node_modules/@oozcitak/dom/**",
      "node_modules/@oozcitak/infra/**",
      "node_modules/@oozcitak/infra/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/url/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/infra/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/infra/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/url/node_modules/@oozcitak/util/**",
      "node_modules/@oozcitak/util/**",
      "node_modules/browser-split/**",
      "node_modules/call-bind-apply-helpers/**",
      "node_modules/call-bound/**",
      "node_modules/camelize/**",
      "node_modules/color-name/**",
      "node_modules/core-util-is/**",
      "node_modules/diff-match-patch/**",
      "node_modules/dom-serializer/**",
      "node_modules/dom-serializer/node_modules/domelementtype/**",
      "node_modules/dom-serializer/node_modules/entities/**",
      "node_modules/dom-walk/**",
      "node_modules/domelementtype/**",
      "node_modules/domhandler/**",
      "node_modules/domutils/**",
      "node_modules/dunder-proto/**",
      "node_modules/encoding/**",
      "node_modules/ent/**",
      "node_modules/ent/node_modules/punycode/**",
      "node_modules/entities/**",
      "node_modules/error/**",
      "node_modules/es-define-property/**",
      "node_modules/es-errors/**",
      "node_modules/es-object-atoms/**",
      "node_modules/ev-store/**",
      "node_modules/function-bind/**",
      "node_modules/get-intrinsic/**",
      "node_modules/get-proto/**",
      "node_modules/global/**",
      "node_modules/gopd/**",
      "node_modules/has-symbols/**",
      "node_modules/has-tostringtag/**",
      "node_modules/hasown/**",
      "node_modules/html-entities/**",
      "node_modules/html-to-docx/**",
      "node_modules/html-to-vdom/**",
      "node_modules/htmlparser2/**",
      "node_modules/iconv-lite/**",
      "node_modules/image-size/**",
      "node_modules/image-to-base64/**",
      "node_modules/immediate/**",
      "node_modules/individual/**",
      "node_modules/inherits/**",
      "node_modules/is-object/**",
      "node_modules/is-regex/**",
      "node_modules/isarray/**",
      "node_modules/jszip/**",
      "node_modules/jszip/node_modules/readable-stream/**",
      "node_modules/jszip/node_modules/safe-buffer/**",
      "node_modules/jszip/node_modules/string_decoder/**",
      "node_modules/lie/**",
      "node_modules/lodash/**",
      "node_modules/math-intrinsics/**",
      "node_modules/mime-db/**",
      "node_modules/mime-types/**",
      "node_modules/min-document/**",
      "node_modules/nanoid/**",
      "node_modules/next-tick/**",
      "node_modules/node-fetch/**",
      "node_modules/pako/**",
      "node_modules/process/**",
      "node_modules/process-nextick-args/**",
      "node_modules/queue/**",
      "node_modules/readable-stream/**",
      "node_modules/safe-buffer/**",
      "node_modules/safe-regex-test/**",
      "node_modules/safer-buffer/**",
      "node_modules/setimmediate/**",
      "node_modules/string_decoder/**",
      "node_modules/string-template/**",
      "node_modules/tr46/**",
      "node_modules/util-deprecate/**",
      "node_modules/virtual-dom/**",
      "node_modules/webidl-conversions/**",
      "node_modules/whatwg-url/**",
      "node_modules/x-is-array/**",
      "node_modules/x-is-string/**",
      "node_modules/xmlbuilder2/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/dom/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/dom/node_modules/@oozcitak/util/**",
      "node_modules/xmlbuilder2/node_modules/@oozcitak/util/**",
      "node_modules/xtend/**",
      "node_modules/vditor/dist/index.min.js",
      "node_modules/vditor/dist/index.css",
      "node_modules/vditor/dist/js/lute/**",
      "node_modules/vditor/dist/js/katex/**",
      "node_modules/vditor/dist/js/mermaid/**",
      "node_modules/vditor/dist/js/highlight.js/**",
      "node_modules/vditor/dist/js/echarts/**",
      "node_modules/vditor/dist/js/markmap/**",
      "node_modules/vditor/dist/js/smiles-drawer/**",
      "node_modules/vditor/dist/images/**",
      "!node_modules/vditor/dist/js/mathjax/**",
      "!node_modules/vditor/dist/js/graphviz/**",
      "!node_modules/vditor/dist/js/abcjs/**",
      "!node_modules/vditor/dist/js/flowchart.js/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mdtxt"
        ],
        "name": "Markdown 文稿",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleDisplayName": "墨流 InkFlow",
        "CFBundleSpokenName": "InkFlow"
      }
    },
    "dmg": {
      "title": "墨流 InkFlow",
      "window": {
        "width": 560,
        "height": 360
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "墨流 InkFlow",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office;TextEditor",
      "target": [
        "AppImage",
        "zip"
      ]
    },
    "asarUnpack": [
      "node_modules/html-to-docx/**"
    ]
  }
}
